# Скопируйте в .env.production на сервере (не коммитить секреты).
# NEXT_PUBLIC_* также передаются как build-args при `docker compose build`.

NEXT_PUBLIC_SITE_URL=https://znves.ru
NEXT_PUBLIC_API_BASE_URL=https://api.znves.ru
NEXT_PUBLIC_USE_MOCKS=false

# СДЭК
CDEK_ACCOUNT=
CDEK_SECURE_PASSWORD=

# Яндекс.Доставка
YA_DELIVERY_TOKEN=
YA_DELIVERY_SOURCE_ADDRESS=Москва, Промышленная улица, 12А, 115516
NEXT_PUBLIC_YA_DELIVERY_SOURCE_ADDRESS=Москва, Промышленная улица, 12А, 115516
YA_DELIVERY_SOURCE_LAT=55.6342
YA_DELIVERY_SOURCE_LON=37.6384

# Яндекс.Карты / Suggest (опционально)
NEXT_PUBLIC_YANDEX_MAPS_API_KEY=
YANDEX_SUGGEST_API_KEY=

# Next.js BFF (server-only; never prefix secrets with NEXT_PUBLIC_)
# Generate with: openssl rand -hex 32
# Required in production. Use the same value on all app replicas; retain across deployments.
BFF_SESSION_SECRET=
# Optional private upstream URL; defaults to NEXT_PUBLIC_API_BASE_URL.
BACKEND_API_URL=https://api.znves.ru
