# СДЭК API (документация: https://apidoc.cdek.ru/)
# Учётные данные для OAuth (Account = client_id, Secure password = client_secret).
# Если заданы — список ПВЗ на карте оформления заказа берётся из GET /api/cdek/pvz.
CDEK_ACCOUNT=
CDEK_SECURE_PASSWORD=

# Яндекс.Доставка (виджет ПВЗ)
# Идентификатор станции (token) для виджета YaDelivery.
# В боевом окружении сюда нужно записать ваш реальный токен.
NEXT_PUBLIC_YA_DELIVERY_STATION_ID=
