# Шаблон переменных. Скопируйте в .env для локальной разработки.
# На проде (Vercel и др.) .env из репо не подхватывается — добавьте переменные
# в настройках хоста (Environment Variables). Подробно: см. DEPLOYMENT.md

# Сайт
NEXT_PUBLIC_SITE_URL=https://znves.ru
NEXT_PUBLIC_API_BASE_URL=https://api.znves.ru

# Локальные моки API (auth, каталог, заказы). В dev включены по умолчанию. Код: 123456
# Отключить моки в dev: NEXT_PUBLIC_USE_MOCKS=false

# СДЭК API (OAuth: client_id, client_secret)
CDEK_ACCOUNT=
CDEK_SECURE_PASSWORD=

# Яндекс.Доставка — Bearer-токен B2B API (из личного кабинета → Интеграции → Получить токен)
YA_DELIVERY_TOKEN=

# Яндекс.Доставка — адрес ПВЗ «откуда везём»
YA_DELIVERY_SOURCE_ADDRESS="Москва, Промышленная улица, 12А, 115516"
NEXT_PUBLIC_YA_DELIVERY_SOURCE_ADDRESS="Москва, Промышленная улица, 12А, 115516"
# Координаты склада (если задать — геокодер не нужен, расчёт работает без доп. ключей)
YA_DELIVERY_SOURCE_LAT=55.6342
YA_DELIVERY_SOURCE_LON=37.6384

# Яндекс.Карты и подсказки адресов (опционально)
NEXT_PUBLIC_YANDEX_MAPS_API_KEY=
YANDEX_SUGGEST_API_KEY=
