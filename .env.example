# СДЭК API (документация: https://apidoc.cdek.ru/)
# Учётные данные для OAuth (Account = client_id, Secure password = client_secret).
# На проде задайте в настройках хоста (Vercel и т.д.) — иначе расчёт времени/цены доставки не работает.
# Допустимы альтернативные имена: CDEK_CLIENT_ID, CDEK_CLIENT_SECRET.
CDEK_ACCOUNT=
CDEK_SECURE_PASSWORD=

# Яндекс.Доставка (виджет ПВЗ) — адрес ПВЗ «откуда везём»
# На проде лучше задать серверную переменную YA_DELIVERY_SOURCE_ADDRESS (читается в runtime через GET /api/delivery/config).
# NEXT_PUBLIC_ — подставляется при сборке; на проде может быть не задан.
YA_DELIVERY_SOURCE_ADDRESS='Москва, Промышленная улица, 12А, 115516'
NEXT_PUBLIC_YA_DELIVERY_SOURCE_ADDRESS='Москва, Промышленная улица, 12А, 115516'
